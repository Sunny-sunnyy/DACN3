# Shopping Assistant V3 environment template.
# Copy to .env and fill in real values. Never commit .env.
# Defaults below are mock-safe: no network, no paid model calls.

# Safety flags (keep false for default/mock mode and all default tests)
ENABLE_REAL_SEARCH=false
ENABLE_REAL_MODEL_CALLS=false
ENABLE_AGENTS_SDK=false

# Persistence (SQLite for local MVP)
DATABASE_URL=sqlite:///shopping_assistant_v3/backend/database/app.db

# Model configuration (Phase 5 Router/Synthesizer; optional Agents SDK path)
MODEL_PROVIDER=openai
MODEL_ID_ROUTER=
MODEL_ID_SYNTHESIZER=
PRICER_PREPROCESSOR_MODEL=

# Specialist pricing — Modal fine-tuned model (Phase 4C.3)
# Leave empty for mock mode. Set service/class names for real Modal calls.
PRICER_SPECIALIST_SERVICE=
PRICER_SPECIALIST_CLASS=

# Secrets (leave empty here; set only in local .env)
OPENAI_API_KEY=
